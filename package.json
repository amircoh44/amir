{
  "name": "amir",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @amir/web",
    "build": "npm run build --workspace @amir/web",
    "lint": "npm run lint --workspace @amir/web",
    "mobile": "npm --prefix apps/mobile run start",
    "proxy:dev": "npm run dev --workspace @amir/rates-proxy",
    "proxy:deploy": "npm run deploy --workspace @amir/rates-proxy",
    "verify": "esbuild scripts/verify-rates.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-rates.cjs --log-level=error && node node_modules/.cache/verify-rates.cjs",
    "typecheck": "tsc -b apps/web && npm run typecheck --workspace @amir/rates-proxy",
    "mobile:install": "npm --prefix apps/mobile install",
    "verify:proxy": "esbuild scripts/verify-proxy.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-proxy.cjs --log-level=error && node node_modules/.cache/verify-proxy.cjs",
    "verify:all": "npm run verify && npm run verify:proxy"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
