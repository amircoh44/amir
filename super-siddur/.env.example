# Copy to .env to override the dev defaults (recommended for production).
#   cp .env.example .env     (Windows:  copy .env.example .env)
# All are OPTIONAL now — docker compose runs without a .env using safe dev values.

# Secret used to sign admin login sessions (JWT). CHANGE for production.
SIDDUR_JWT_SECRET=dev-secret-change-in-production

# Initial password for the seeded super-admins (change after first login).
SIDDUR_SUPERADMIN_PASSWORD=changeme123

# Optional: comma-separated super-admin emails.
# SIDDUR_SUPERADMIN_EMAILS=amir@graphicatz.com,shalomlebowitz@gmail.com
