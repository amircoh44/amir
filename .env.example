# =====================================================================
# GreenBulk — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# =====================================================================

# --- App ---
APP_NAME="GreenBulk Wholesale"
ENVIRONMENT=development              # development | staging | production
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string   # used to sign sessions/CSRF

# --- Database (PostgreSQL) ---
# Async URL is used by the app; the sync URL is derived for Alembic/scripts.
DATABASE_URL=postgresql+asyncpg://greenbulk:greenbulk@localhost:5432/greenbulk

# --- Redis (rate limiting + caching). Optional in dev. ---
REDIS_URL=redis://localhost:6379/0

# --- Auth: JWT sessions ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth (primary sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# --- SendGrid ---
SENDGRID_API_KEY=
EMAIL_FROM=orders@greenbulk.example
EMAIL_FROM_NAME="GreenBulk Orders"
# If unset / in development, emails are written to the console instead of sent.

# --- Rate limits (requests per window) ---
RATELIMIT_AUTH="10/minute"
RATELIMIT_PUBLIC_API="120/minute"

# --- Geocoding (address -> lat/lon for the customer globe) ---
# Default provider is OpenStreetMap Nominatim (free, no key). Set a real
# contact in the user agent per their usage policy. Disable to skip lookups.
GEOCODING_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT="GreenBulk/0.1 (admin@greenbulk.example)"
DEFAULT_COUNTRY=USA

# --- Compliance gating ---
# New B2B accounts start unverified and cannot purchase until an admin approves.
REQUIRE_BUSINESS_VERIFICATION=true
# Comma-separated ISO state codes you are NOT permitted to ship to.
RESTRICTED_STATES=ID,KS,NE
MINIMUM_AGE=21
