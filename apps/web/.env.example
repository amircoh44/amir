# Base URL of the deployed rate proxy (services/rates-proxy).
# Local dev: `npm run proxy:dev` serves it on http://localhost:8787
VITE_RATES_PROXY_URL=http://localhost:8787

# Optional shared token, only if you set CLIENT_TOKEN on the proxy.
# This is NOT the EasyPost key — that never leaves the proxy.
VITE_RATES_PROXY_TOKEN=
